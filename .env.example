# Database
# Local dev matches docker-compose.yml; use your cloud URL (e.g. Neon) in prod.
DATABASE_URL="postgresql://lifeflow:lifeflow_dev@localhost:5432/lifeflow"

# Auth.js
AUTH_SECRET="" # Generate with: npx auth secret
# Set to true when running behind a proxy/tunnel (Vercel, ngrok, etc.).
AUTH_TRUST_HOST="true"

# Sign-in allow-list (RECOMMENDED for an unadvertised / portfolio deployment).
# Comma-separated Google emails. When set, ONLY these accounts can sign in —
# random visitors can't create accounts and consume your AI/Gmail quota. Leave
# empty to allow any Google account to sign up.
# ALLOWED_EMAILS="you@gmail.com,friend@gmail.com"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Token encryption key — 32 bytes hex. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
# REQUIRED: validates incoming Telegram webhook requests. If unset, the webhook
# route rejects every request (401). Generate with: openssl rand -hex 32
# Must match the secret_token you register via Telegram's setWebhook.
TELEGRAM_WEBHOOK_SECRET=""

# Gemini (primary AI provider; Groq is the fallback)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL="gemini-2.0-flash"

# Groq AI (fallback when Gemini is unset/errors)
GROQ_API_KEY=""

# Cron
# REQUIRED: protects the /api/cron/* routes. If unset, those routes reject every
# request (401). Callers must send: Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -hex 32
CRON_SECRET=""
